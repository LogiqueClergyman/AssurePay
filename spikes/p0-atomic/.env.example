# Required: 24-word Pera Universal Wallet BIP-39 recovery phrase. Never commit a populated .env file.
TESTNET_PAYER_HD_MNEMONIC=
# Required: public Pera address derived from the configured phrase/indices; this is a mandatory safety assertion.
TESTNET_PAYER_ADDRESS=
# Optional: Pera BIP-44 account index. Defaults to 0, as established by Pera's current HD wallet implementation.
TESTNET_PAYER_ACCOUNT_INDEX=0
# Optional: Pera BIP-44 external address index. Defaults to 0, as established by Pera's current HD wallet implementation.
TESTNET_PAYER_ADDRESS_INDEX=0
# Required: existing TestNet ASA ID. The runner never creates or guesses this asset.
TESTNET_ASA_ID=
# Required: TestNet algod base URL, for example https://testnet-api.algonode.cloud
TESTNET_ALGOD_SERVER=
# Optional: port when the endpoint requires one. Leave blank when embedded in the URL/default HTTPS port.
TESTNET_ALGOD_PORT=
# Optional: API token. Leave blank for a public endpoint.
TESTNET_ALGOD_TOKEN=
# Optional: header name for TESTNET_ALGOD_TOKEN, default X-Algo-API-Token.
TESTNET_ALGOD_TOKEN_HEADER=X-Algo-API-Token
