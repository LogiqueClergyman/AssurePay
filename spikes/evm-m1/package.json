{
  "name": "@assurepay/evm-m1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node --import tsx scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:execution": "node --import tsx --test test/execution.test.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "public:check": "node --import tsx scripts/check-public-config.ts",
    "public:run": "node --import tsx scripts/public-run.ts",
    "public:verify": "node --import tsx scripts/verify-public.ts",
    "wallets:setup": "node --import tsx scripts/setup-test-wallets.ts",
    "vault:setup": "node --import tsx scripts/setup-vault.ts",
    "vault:fund": "node --env-file=.env.local --env-file=.env.vault.local --import tsx scripts/vault-funding.ts"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "24.10.1",
    "solc": "0.8.30",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
