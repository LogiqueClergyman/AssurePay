# Copy values into the runtime environment. This file is a template only.
# BASE_SEPOLIA_RPC_URL is optional; the public Base Sepolia endpoint is the default.
EXPECTED_PAYER=0x1111111111111111111111111111111111111111
RELAYER_ADDRESS=0x2222222222222222222222222222222222222222
PROVIDER_PAYOUT=0x3333333333333333333333333333333333333333

# Maximum transaction-fee and bounded attempt allowances, in integer atomic units.
MAX_FEE_PER_GAS_ATOMIC=10000000000
MAX_PRIORITY_FEE_PER_GAS_ATOMIC=1000000000
# Must cover the fixed 3,100,000 gas cap total and cannot exceed 4,000,000.
MAX_TOTAL_GAS=3100000
# Explicit positive Base L1-fee allowance, in wei.
MAX_L1_FEE_WEI=1000000000000000

# Execution requires --execute and this exact one-session scope value.
# M1_PUBLIC_SCOPE=deploy-success-admission-revert-once
# PAYER_PRIVATE_KEY is runtime-only; never place it in this template.
# RELAYER_PRIVATE_KEY is runtime-only; never place it in this template.
